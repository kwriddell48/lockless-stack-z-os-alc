//STKALLOC JOB (ACCT),'ALLOC PDSE LIBS',CLASS=A,MSGCLASS=H,
//         NOTIFY=&SYSUID,TIME=1
//*
//* DELETE OLD STACK LIBRARIES (IGNORE NOT-FOUND), THEN ALLOCATE PDSE
//*   .ASM .MAC .JCL .OBJ .LOAD  plus  .C (source) and .H (includes)
//*
//DELETE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE Z72675.STACK.JCL
  DELETE Z72675.STACK.MAC
  DELETE Z72675.STACK.ASM
  DELETE Z72675.STACK.OBJ
  DELETE Z72675.STACK.LOAD
  DELETE Z72675.STACK.C
  DELETE Z72675.STACK.H
  SET MAXCC=0
/*
//*
//ALLOC    EXEC PGM=IEFBR14
//MACLIB   DD DSN=Z72675.STACK.MAC,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(3,3,1)),
//            DSNTYPE=LIBRARY,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//JCLLIB   DD DSN=Z72675.STACK.JCL,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(3,3,1)),
//            DSNTYPE=LIBRARY,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SRCLIB   DD DSN=Z72675.STACK.ASM,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(3,3,1)),
//            DSNTYPE=LIBRARY,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//OBJLIB   DD DSN=Z72675.STACK.OBJ,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(3,3,1)),
//            DSNTYPE=LIBRARY,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//LOADLIB  DD DSN=Z72675.STACK.LOAD,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(3,3,1)),
//            DSNTYPE=LIBRARY,
//            DCB=(RECFM=U,LRECL=0,BLKSIZE=32760)
//CLIB     DD DSN=Z72675.STACK.C,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(3,3,1)),
//            DSNTYPE=LIBRARY,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//HLIB     DD DSN=Z72675.STACK.H,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(3,3,1)),
//            DSNTYPE=LIBRARY,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
