//STKALCCH JOB (ACCT),'ALLOC C AND H',CLASS=A,MSGCLASS=H,
//         NOTIFY=&SYSUID,TIME=1
//*
//* ALLOCATE ONLY THE C SOURCE AND H INCLUDE PDSES.
//* DOES NOT DELETE ASM/MAC/OBJ/LOAD/JCL.
//*
//*   TEST/*.c  -> Z72675.STACK.C  (FB 80)
//*   TEST/*.h  -> Z72675.STACK.H  (FB 80)
//*
//* COMPILE JCL MUST SPECIFY NOSEQUENCE (COLS 73-80 ARE SOURCE,
//* NOT SEQUENCE NUMBERS).
//*
//DELETE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE Z72675.STACK.C
  DELETE Z72675.STACK.H
  SET MAXCC=0
/*
//*
//ALLOC    EXEC PGM=IEFBR14
//CLIB     DD DSN=Z72675.STACK.C,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(5,5,1)),
//            DSNTYPE=LIBRARY,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//HLIB     DD DSN=Z72675.STACK.H,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,
//            SPACE=(TRK,(3,3,1)),
//            DSNTYPE=LIBRARY,
