//MPMCTEST JOB (ACCT),'MPMC C TESTS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M,LINES=999999,TIME=1
//*-------------------------------------------------------------------*
//* Compile, bind, and run all MPMC C tests (T01VER .. T16OWNER).
//*
//* Upload first (EBCDIC, RECFM=FB,LRECL=80):
//*   TEST/cglue.asm     -> &HLQ..STACK.ASM(CGLUE)
//*   TEST/testcb.asm    -> &HLQ..STACK.ASM(TESTCB)
//*   TEST/mpmcs.h       -> &HLQ..STACK.H(MPMCS)
//*   TEST/mpmcs.c       -> &HLQ..STACK.C(MPMCS)
//*   TEST/t01ver.c      -> &HLQ..STACK.C(T01VER)
//*   ... t16owner.c     -> &HLQ..STACK.C(T16OWNER)
//* Allocate C/H with jcl/stkalloc.jcl or jcl/stkalloc_ch.jcl.
//*
//* Stack objects must already be in &HLQ..STACK.OBJ (from your ASMA90
//* job). Change the SET names below if your members differ
//* (MPMCQSTO, MPMCQNT, MPMCQVER, ...).
//*
//* Also required:
//*   &HLQ..STACK.LOAD   PDSE load library
//*   CBC + CEE datasets on STEPLIB / SYSLIB (site names below)
//*
//* C is AMODE 31, NOXPLINK, GOFF, LONGNAME. Entry is CEESTART.
//*
//* Step RC:  0 PASS   4 T13PAY64 skip (no IARV64)   8 FAIL
//*-------------------------------------------------------------------*
//         SET  HLQ=Z72675
//         SET  CBC=CBC
//         SET  CEE=CEE
//*-------------------------------------------------------------------*
//* PROCS
//*-------------------------------------------------------------------*
//ASMEM    PROC HLQ=,MEM=
//ASM      EXEC PGM=ASMA90,REGION=0M,
//             PARM='GOFF,MACHINE(Z15),RENT,NOLIST,NOESD,NORLD'
//SYSLIB   DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//         DD  DISP=SHR,DSN=&HLQ..STACK.MAC
//         DD  DISP=SHR,DSN=&HLQ..STACK.ASM
//SYSIN    DD  DISP=SHR,DSN=&HLQ..STACK.ASM(&MEM)
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DISP=SHR,DSN=&HLQ..STACK.OBJ(&MEM)
//SYSUT1   DD  UNIT=VIO,SPACE=(CYL,(1,1))
//         PEND
//*
//CCOMP    PROC HLQ=,MEM=,CBC=CBC,CEE=CEE
//CC       EXEC PGM=CCNDRVR,REGION=0M,
//             PARM='OPTFILE(DD:SYSOPTF)'
//STEPLIB  DD  DISP=SHR,DSN=&CBC..SCCNCMP
//         DD  DISP=SHR,DSN=&CEE..SCEERUN
//         DD  DISP=SHR,DSN=&CEE..SCEERUN2
//SYSMSGS  DD  DISP=SHR,DSN=&CBC..SCCNSAM(EDCMSGE)
//SYSOPTF  DD  *,SYMBOLS=JCLONLY
NOXPLINK
RENT
LONGNAME
LANGLVL(EXTENDED)
GOFF
NOSOURCE
NOSEQUENCE
SEARCH(//'&HLQ..STACK.H')
/*
//SYSIN    DD  DISP=SHR,DSN=&HLQ..STACK.C(&MEM)
//SYSLIN   DD  DISP=SHR,DSN=&HLQ..STACK.OBJ(&MEM)
//SYSLIB   DD  DISP=SHR,DSN=&HLQ..STACK.H
//         DD  DISP=SHR,DSN=&CEE..SCEEH.H
//         DD  DISP=SHR,DSN=&CEE..SCEEH.SYS.H
//SYSPRINT DD  SYSOUT=*
//SYSCPRT  DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUT1   DD  UNIT=VIO,SPACE=(CYL,(1,1))
//SYSUT2   DD  UNIT=VIO,SPACE=(CYL,(1,1))
//SYSUT3   DD  UNIT=VIO,SPACE=(CYL,(1,1))
//SYSUT4   DD  UNIT=VIO,SPACE=(CYL,(1,1))
//SYSUT5   DD  UNIT=VIO,SPACE=(CYL,(1,1))
//SYSUT6   DD  UNIT=VIO,SPACE=(CYL,(1,1))
//SYSUT7   DD  UNIT=VIO,SPACE=(CYL,(1,1))
//SYSUT8   DD  UNIT=VIO,SPACE=(CYL,(1,1))
//SYSUT9   DD  UNIT=VIO,SPACE=(CYL,(1,1))
//SYSUT10  DD  UNIT=VIO,SPACE=(CYL,(1,1))
//         PEND
//*
//* Job-level SET names are NOT substituted in PROC instream
//* (only PROC symbols like &MEM are). Edit the INCLUDE member
//* names here if your stack objects differ (MPMCQSTO, ...).
//BNDRUN   PROC HLQ=,MEM=,CBC=CBC,CEE=CEE
//BIND     EXEC PGM=IEWBLINK,REGION=0M,
//             PARM='RENT,LIST,MAP,XREF,LET,CASE=MIXED,AMODE=31'
//* NAME omitted: member comes from SYSLMOD DSN(...(&MEM))
//SYSLIN   DD  *
 INCLUDE TESTOBJ
 INCLUDE OBJ(MPMCS)
 INCLUDE OBJ(CGLUE)
 INCLUDE OBJ(TESTCB)
 INCLUDE OBJ(MPMCQ)
 INCLUDE OBJ(FREELIST)
 INCLUDE OBJ(STORAGE)
 INCLUDE OBJ(NOTIFY)
 INCLUDE OBJ(STATS)
 INCLUDE OBJ(VERSION)
 INCLUDE OBJ(STAT64T)
 INCLUDE OBJ(TRACE)
 ENTRY   CEESTART
/*
//TESTOBJ  DD  DISP=SHR,DSN=&HLQ..STACK.OBJ(&MEM)
//OBJ      DD  DISP=SHR,DSN=&HLQ..STACK.OBJ
//SYSLIB   DD  DISP=SHR,DSN=&CEE..SCEELKED
//         DD  DISP=SHR,DSN=&CBC..SCCNOBJ
//SYSLMOD  DD  DISP=SHR,DSN=&HLQ..STACK.LOAD(&MEM)
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  UNIT=VIO,SPACE=(TRK,(10,10))
//         PEND
//*
//GORUN    PROC HLQ=,MEM=,RTOPT='/',CEE=CEE
//GO       EXEC PGM=&MEM,REGION=0M,PARM='&RTOPT'
//STEPLIB  DD  DISP=SHR,DSN=&HLQ..STACK.LOAD
//         DD  DISP=SHR,DSN=&CEE..SCEERUN
//         DD  DISP=SHR,DSN=&CEE..SCEERUN2
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//CEEDUMP  DD  SYSOUT=*
//         PEND
//*-------------------------------------------------------------------*
//* Assemble C glue and notifier test callback
//*-------------------------------------------------------------------*
//CGLUE    EXEC ASMEM,HLQ=&HLQ,MEM=CGLUE
//TESTCB   EXEC ASMEM,HLQ=&HLQ,MEM=TESTCB
//STAT64T  EXEC ASMEM,HLQ=&HLQ,MEM=STAT64T
//MPMCQ    EXEC ASMEM,HLQ=&HLQ,MEM=MPMCQ
//FREELIST EXEC ASMEM,HLQ=&HLQ,MEM=FREELIST
//NOTIFY   EXEC ASMEM,HLQ=&HLQ,MEM=NOTIFY
//STATS    EXEC ASMEM,HLQ=&HLQ,MEM=STATS
//VERSION  EXEC ASMEM,HLQ=&HLQ,MEM=VERSION
//TRACE    EXEC ASMEM,HLQ=&HLQ,MEM=TRACE
//*-------------------------------------------------------------------*
//* Compile shared C wrapper once, then each test
//*-------------------------------------------------------------------*
//CCMPMCS  EXEC CCOMP,HLQ=&HLQ,MEM=MPMCS,CBC=&CBC,CEE=&CEE
//*
//CC01     EXEC CCOMP,HLQ=&HLQ,MEM=T01VER,CBC=&CBC,CEE=&CEE
//BD01     EXEC BNDRUN,HLQ=&HLQ,MEM=T01VER,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC01.CC))
//GO01     EXEC GORUN,HLQ=&HLQ,MEM=T01VER,CEE=&CEE,
//             COND=(8,LE,BD01.BIND)
//*
//CC02     EXEC CCOMP,HLQ=&HLQ,MEM=T02INIT,CBC=&CBC,CEE=&CEE
//BD02     EXEC BNDRUN,HLQ=&HLQ,MEM=T02INIT,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC02.CC))
//GO02     EXEC GORUN,HLQ=&HLQ,MEM=T02INIT,CEE=&CEE,
//             COND=(8,LE,BD02.BIND)
//*
//CC03     EXEC CCOMP,HLQ=&HLQ,MEM=T03LIFO,CBC=&CBC,CEE=&CEE
//BD03     EXEC BNDRUN,HLQ=&HLQ,MEM=T03LIFO,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC03.CC))
//GO03     EXEC GORUN,HLQ=&HLQ,MEM=T03LIFO,CEE=&CEE,
//             COND=(8,LE,BD03.BIND)
//*
//CC04     EXEC CCOMP,HLQ=&HLQ,MEM=T04EMPTY,CBC=&CBC,CEE=&CEE
//BD04     EXEC BNDRUN,HLQ=&HLQ,MEM=T04EMPTY,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC04.CC))
//GO04     EXEC GORUN,HLQ=&HLQ,MEM=T04EMPTY,CEE=&CEE,
//             COND=(8,LE,BD04.BIND)
//*
//CC05     EXEC CCOMP,HLQ=&HLQ,MEM=T05TRUNC,CBC=&CBC,CEE=&CEE
//BD05     EXEC BNDRUN,HLQ=&HLQ,MEM=T05TRUNC,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC05.CC))
//GO05     EXEC GORUN,HLQ=&HLQ,MEM=T05TRUNC,CEE=&CEE,
//             COND=(8,LE,BD05.BIND)
//*
//CC06     EXEC CCOMP,HLQ=&HLQ,MEM=T06ZERO,CBC=&CBC,CEE=&CEE
//BD06     EXEC BNDRUN,HLQ=&HLQ,MEM=T06ZERO,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC06.CC))
//GO06     EXEC GORUN,HLQ=&HLQ,MEM=T06ZERO,CEE=&CEE,
//             COND=(8,LE,BD06.BIND)
//*
//CC07     EXEC CCOMP,HLQ=&HLQ,MEM=T07STATS,CBC=&CBC,CEE=&CEE
//BD07     EXEC BNDRUN,HLQ=&HLQ,MEM=T07STATS,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC07.CC))
//GO07     EXEC GORUN,HLQ=&HLQ,MEM=T07STATS,CEE=&CEE,
//             COND=(8,LE,BD07.BIND)
//*
//CC08     EXEC CCOMP,HLQ=&HLQ,MEM=T08TWOQ,CBC=&CBC,CEE=&CEE
//BD08     EXEC BNDRUN,HLQ=&HLQ,MEM=T08TWOQ,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC08.CC))
//GO08     EXEC GORUN,HLQ=&HLQ,MEM=T08TWOQ,CEE=&CEE,
//             COND=(8,LE,BD08.BIND)
//*
//CC09     EXEC CCOMP,HLQ=&HLQ,MEM=T09VARLE,CBC=&CBC,CEE=&CEE
//BD09     EXEC BNDRUN,HLQ=&HLQ,MEM=T09VARLE,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC09.CC))
//GO09     EXEC GORUN,HLQ=&HLQ,MEM=T09VARLE,CEE=&CEE,
//             COND=(8,LE,BD09.BIND)
//*
//CC10     EXEC CCOMP,HLQ=&HLQ,MEM=T10ECB,CBC=&CBC,CEE=&CEE
//BD10     EXEC BNDRUN,HLQ=&HLQ,MEM=T10ECB,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC10.CC))
//GO10     EXEC GORUN,HLQ=&HLQ,MEM=T10ECB,CEE=&CEE,
//             COND=(8,LE,BD10.BIND)
//*
//CC11     EXEC CCOMP,HLQ=&HLQ,MEM=T11CB,CBC=&CBC,CEE=&CEE
//BD11     EXEC BNDRUN,HLQ=&HLQ,MEM=T11CB,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC11.CC))
//GO11     EXEC GORUN,HLQ=&HLQ,MEM=T11CB,CEE=&CEE,
//             COND=(8,LE,BD11.BIND)
//*
//CC12     EXEC CCOMP,HLQ=&HLQ,MEM=T12CONC,CBC=&CBC,CEE=&CEE
//BD12     EXEC BNDRUN,HLQ=&HLQ,MEM=T12CONC,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC12.CC))
//GO12     EXEC GORUN,HLQ=&HLQ,MEM=T12CONC,CEE=&CEE,
//             RTOPT='POSIX(ON)/',
//             COND=(8,LE,BD12.BIND)
//*
//CC13     EXEC CCOMP,HLQ=&HLQ,MEM=T13PAY64,CBC=&CBC,CEE=&CEE
//BD13     EXEC BNDRUN,HLQ=&HLQ,MEM=T13PAY64,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC13.CC))
//GO13     EXEC GORUN,HLQ=&HLQ,MEM=T13PAY64,CEE=&CEE,
//             COND=(8,LE,BD13.BIND)
//*
//CC14     EXEC CCOMP,HLQ=&HLQ,MEM=T14ADD64,CBC=&CBC,CEE=&CEE
//BD14     EXEC BNDRUN,HLQ=&HLQ,MEM=T14ADD64,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC14.CC))
//GO14     EXEC GORUN,HLQ=&HLQ,MEM=T14ADD64,CEE=&CEE,
//             RTOPT='POSIX(ON)/',
//             COND=(8,LE,BD14.BIND)
//*
//CC15     EXEC CCOMP,HLQ=&HLQ,MEM=T15TRACE,CBC=&CBC,CEE=&CEE
//BD15     EXEC BNDRUN,HLQ=&HLQ,MEM=T15TRACE,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC15.CC))
//GO15     EXEC GORUN,HLQ=&HLQ,MEM=T15TRACE,CEE=&CEE,
//             COND=(8,LE,BD15.BIND)
//*
//CC16     EXEC CCOMP,HLQ=&HLQ,MEM=T16OWNER,CBC=&CBC,CEE=&CEE
//BD16     EXEC BNDRUN,HLQ=&HLQ,MEM=T16OWNER,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC16.CC))
//GO16     EXEC GORUN,HLQ=&HLQ,MEM=T16OWNER,CEE=&CEE,
//             RTOPT='POSIX(ON)/',
//             COND=(8,LE,BD16.BIND)
//*
//CC17     EXEC CCOMP,HLQ=&HLQ,MEM=T17STORM,CBC=&CBC,CEE=&CEE
//BD17     EXEC BNDRUN,HLQ=&HLQ,MEM=T17STORM,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC17.CC))
//GO17     EXEC GORUN,HLQ=&HLQ,MEM=T17STORM,CEE=&CEE,
//             RTOPT='POSIX(ON)/',
//             COND=(8,LE,BD17.BIND)
//*
//CC18     EXEC CCOMP,HLQ=&HLQ,MEM=T18MIXQ,CBC=&CBC,CEE=&CEE
//BD18     EXEC BNDRUN,HLQ=&HLQ,MEM=T18MIXQ,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC18.CC))
//GO18     EXEC GORUN,HLQ=&HLQ,MEM=T18MIXQ,CEE=&CEE,
//             RTOPT='POSIX(ON)/',
//             COND=(8,LE,BD18.BIND)
//*
//CC19     EXEC CCOMP,HLQ=&HLQ,MEM=T19CBMT,CBC=&CBC,CEE=&CEE
//BD19     EXEC BNDRUN,HLQ=&HLQ,MEM=T19CBMT,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC19.CC))
//GO19     EXEC GORUN,HLQ=&HLQ,MEM=T19CBMT,CEE=&CEE,
//             RTOPT='POSIX(ON)/',
//             COND=(8,LE,BD19.BIND)
//*
//CC20     EXEC CCOMP,HLQ=&HLQ,MEM=T20WAVE,CBC=&CBC,CEE=&CEE
//BD20     EXEC BNDRUN,HLQ=&HLQ,MEM=T20WAVE,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC20.CC))
//GO20     EXEC GORUN,HLQ=&HLQ,MEM=T20WAVE,CEE=&CEE,
//             RTOPT='POSIX(ON)/',
//             COND=(8,LE,BD20.BIND)
//*
//CC21     EXEC CCOMP,HLQ=&HLQ,MEM=T21BURST,CBC=&CBC,CEE=&CEE
//BD21     EXEC BNDRUN,HLQ=&HLQ,MEM=T21BURST,CBC=&CBC,CEE=&CEE,
//             COND=((8,LE,CCMPMCS.CC),(8,LE,CC21.CC))
//GO21     EXEC GORUN,HLQ=&HLQ,MEM=T21BURST,CEE=&CEE,
//             RTOPT='POSIX(ON)/',
//             COND=(8,LE,BD21.BIND)
//*
//* T09 member is T09VARLE (8 chars) from t09varlen.c
//* T13PAY64 RC=4 is SKIP (IARV64 GETSTOR not authorized), not FAIL.
//
