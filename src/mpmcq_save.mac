         TITLE 'MPMCQ standard save-area enter/return helpers'
***********************************************************************
*  MPMCQ_SAVE.MAC
*
*  Fast path: MPMCQ_ENTER_SCB / MPMCQ_RETURN_SCB use the per-SCB work
*  cell pool (MPMCS_WORKGET / MPMCS_WORKPUT — no STM, register-only).
*  GETMAIN only on pool miss; FREEMAIN is avoided on RETURN (cell recycled).
*
*  Slow path: MPMCQ_ENTER / MPMCQ_RETURN for GETVERSION and SINIT bootstrap.
***********************************************************************

SA_LEN   EQU   72

         MACRO
&LBL     MPMCQ_ENTER &WLEN
&LBL.    STM   R14,R12,12(R13)
         LR    R12,R15
         LA    R0,&WLEN
         GETMAIN RU,LV=(R0),LOC=BELOW
         ST    R13,4(R1)
         ST    R1,8(R13)
         LR    R13,R1
         L     R1,4(R13)
         L     R1,24(R1)
         MEND

         MACRO
&LBL     MPMCQ_RETURN &RC,&WLEN
&LBL.    LR    R1,R13
         L     R13,4(R13)
         LR    R15,&RC
         LA    R0,&WLEN
         FREEMAIN RU,A=(R1),LV=(R0)
         ST    R15,16(R13)
         LM    R14,R12,12(R13)
         BR    R14
         MEND

         MACRO
&LBL     MPMCQ_RETURN_R01 &RC,&WLEN
&LBL.    LR    R3,R13
         L     R13,4(R13)
         LR    R15,&RC
         ST    R0,20(R13)
         ST    R1,24(R13)
         ST    R15,16(R13)
         LA    R0,&WLEN
         LR    R1,R3
         FREEMAIN RU,A=(R1),LV=(R0)
         LM    R14,R12,12(R13)
         BR    R14
         MEND

         MACRO
&LBL     MPMCQ_ENTER_SCB
.* R1 -> plist with SCBaddr at +0. Uses MPMCS_WORK_CELL-sized cells.
&LBL.    STM   R14,R12,12(R13)
         LR    R12,R15
         L     Q_R,0(R1)                   SCB address
         LR    R3,R1                       keep plist across WORKGET
         L     R15,=V(MPMCS_WORKGET)
         BALR  R14,R15                     naked: R1=cell R15=0|4
         LTR   R15,R15
         JZ    &LBL.HAVE
         LA    R0,MPMCS_WORK_CELL
         GETMAIN RU,LV=(R0),LOC=BELOW      pool empty — cold path
         J     &LBL.CHAIN
&LBL.HAVE EQU  *
* R1 = pooled cell
&LBL.CHAIN EQU *
         ST    R13,4(R1)
         ST    R1,8(R13)
         LR    R13,R1
         LR    R1,R3                       restore plist
         MEND

         MACRO
&LBL     MPMCQ_RETURN_SCB &RC
.* Recycle work cell onto SCB pool (Q_R must still address the SCB).
&LBL.    LR    R1,R13                      cell
         L     R13,4(R13)                  caller's SA
         LR    R3,&RC                      RC in R3 across WORKPUT
         L     R15,=V(MPMCS_WORKPUT)
         BALR  R14,R15                     naked: in Q_R,R1=cell
         LR    R15,R3
         ST    R15,16(R13)
         LM    R14,R12,12(R13)
         BR    R14
         MEND

         MACRO
&LBL     MPMCQ_LEAF_RETURN &RC
&LBL.    LR    R15,&RC
         ST    R15,16(R13)
         LM    R14,R12,12(R13)
         BR    R14
         MEND

         MACRO
&LBL     MPMCQ_LEAF_RETURN_R1 &RC,&R1REG
&LBL.    LR    R1,&R1REG
         LR    R15,&RC
         ST    R1,24(R13)
         ST    R15,16(R13)
         LM    R14,R12,12(R13)
         BR    R14
         MEND

         MACRO
&LBL     MPMCQ_LEAF_RETURN_R8 &RC
&LBL.    LR    R15,&RC
         ST    R8,52(R13)
         ST    R15,16(R13)
         LM    R14,R12,12(R13)
         BR    R14
         MEND
